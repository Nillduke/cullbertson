APP_NAME="Culbertson Agency"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.com
# cPanel split-folder installation only; replace CPANEL_USERNAME.
APP_PUBLIC_PATH=/home/CPANEL_USERNAME/public_html
SEARCH_ENGINE_INDEXING=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=/home/CPANEL_USERNAME/culbertson_app/database/database.sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
# Set real SMTP settings before enabling email delivery.
MAIL_FROM_ADDRESS=hello@YOUR-DOMAIN.com
MAIL_FROM_NAME="Culbertson Agency"

# Optional Google tags load only after visitor analytics/ads consent.
GOOGLE_TRACKING_ENABLED=true
